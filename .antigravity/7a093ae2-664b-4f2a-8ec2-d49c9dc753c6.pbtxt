        }
        lines {
          text: "            <input type=\"checkbox\" checked={showSantaCruz} onChange={e => setShowSantaCruz(e.target.checked)} className=\"rounded border-neutral-300 text-amber-500 focus:ring-amber-500 w-4 h-4 cursor-pointer\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
