          text: "    exportCSV(csv, \'national_cpi_data.csv\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  };"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  return ("
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    <div className=\"flex flex-col h-full\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      <div className=\"flex flex-col lg:flex-row lg:items-start justify-between gap-6 mb-8\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <h2 className=\"text-xl font-bold tracking-tight mb-2\">National CPI Trends</h2>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "          <p className=\"text-sm text-neutral-500\">Synthetic trajectory benchmarking against official reports.</p>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        "
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "        <div className=\"flex flex-wrap gap-x-6 gap-y-3 p-4 bg-neutral-50 rounded-xl border border-neutral-100\">"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
