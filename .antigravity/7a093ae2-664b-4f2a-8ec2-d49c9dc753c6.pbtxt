        }
        lines {
          text: "function NationalView({ data, lang, t }: { data: DataStore, lang: Lang, t: typeof T[\'en\'] }) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [showLaPaz, setShowLaPaz] = useState(false);"
