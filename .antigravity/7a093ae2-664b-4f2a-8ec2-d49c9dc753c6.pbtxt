          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    return ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      <div className=\"bg-white border border-neutral-200 p-4 rounded-xl shadow-xl z-50 min-w-[200px]\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        <p className=\"font-medium text-neutral-900 border-b border-neutral-100 pb-2 mb-3\">{label}</p>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        <div className=\"space-y-2\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          {payload.map((p: any, idx: number) => ("
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            <div key={idx} className=\"flex items-center justify-between gap-4 text-sm\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <div className=\"flex items-center gap-2\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                <span className=\"w-2.5 h-2.5 rounded-full\" style={{ backgroundColor: p.stroke || p.fill }} />"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                <span className=\"text-neutral-600 truncate max-w-[180px]\">{p.name}</span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              <span className=\"font-semibold font-mono text-neutral-900 tabular-nums\">"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "                {typeof p.value === \'number\' ? p.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : p.value}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "              </span>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "            </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "          ))}"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "        </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "      </div>"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "    );"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  }"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "  return null;"
          type: UNIFIED_DIFF_LINE_TYPE_INSERT
        }
        lines {
          text: "}"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
      }
    }
    instruction: "Replace with full dashboard code"
    replacement_infos {
      original_chunk {
        target_content: "/**\n * @license\n * SPDX-License-Identifier: Apache-2.0\n */\n\nexport default function App() {\n  return <div></div>;\n}\n"
        replacement_content: "import { useState, useEffect, useMemo } from \'react\';\nimport Papa from \'papaparse\';\nimport {\n  LineChart, Line, XAxis, YAxis, CartesianGrid, Tooltip, Legend, ResponsiveContainer, AreaChart, Area\n} from \'recharts\';\nimport { Download, Info, Loader2 } from \'lucide-react\';\n\nconst DATA_URLS = {\n  nationalSynthetic: \'https://raw.githubusercontent.com/thomasriveros/robust-cpi-bolivia/refs/heads/main/results/supermarket_1/national/supermarket_1_tracker_results.csv\',\n  laPazSynthetic: \'https://raw.githubusercontent.com/thomasriveros/robust-cpi-bolivia/refs/heads/main/results/supermarket_1/la_paz/supermarket_1_tracker_results.csv\',\n  cochabambaSynthetic: \'https://raw.githubusercontent.com/thomasriveros/robust-cpi-bolivia/refs/heads/main/results/supermarket_1/cochabamba/supermarket_1_tracker_results.csv\',\n  santaCruzSynthetic: \'https://raw.githubusercontent.com/thomasriveros/robust-cpi-bolivia/refs/heads/main/results/supermarket_1/santa_cruz/supermarket_1_tracker_results.csv\',\n  productCounts: \'https://raw.githubusercontent.com/thomasriveros/robust-cpi-bolivia/refs/heads/main/results/supermarket_1/supermarket_1_daily_n_counts.csv\',\n  nationalOfficial: \'https://raw.githubusercontent.com/thomasriveros/robust-cpi-bolivia/refs/heads/main/config/National%20CPI%20By%20Category.csv\',\n  laPazOfficial: \'https://raw.githubusercontent.com/thomasriveros/robust-cpi-bolivia/refs/heads/main/config/La%20Paz%20Official%20Eq.csv\',\n  cochabambaOfficial: \'https://raw.githubusercontent.com/thomasriveros/robust-cpi-bolivia/refs/heads/main/config/Cochabamba%20Official%20Eq.csv\',\n  santaCruzOfficial: \'https://raw.githubusercontent.com/thomasriveros/robust-cpi-bolivia/refs/heads/main/config/Santa%20Cruz%20Official%20Eq.csv\',\n};\n\n// Colors for graphing\nconst COLORS = [\n  \'#0ea5e9\', // light blue\n  \'#f43f5e\', // rose\n  \'#10b981\', // emerald\n  \'#f59e0b\', // amber\n  \'#8b5cf6\', // violet\n  \'#64748b\', // slate\n];\n\nconst OFFICIAL_COLOR = \'#1e293b\';\n\ntype DataStore = { [key: string]: any[] };\n\nexport default function App() {\n  const [data, setData] = useState<DataStore>({});\n  const [loading, setLoading] = useState(true);\n  const [activeTab, setActiveTab] = useState(\'national\');\n\n  // Load all CSVs\n  useEffect(() => {\n    const fetchAll = async () => {\n      setLoading(true);\n      const results: DataStore = {};\n      \n      const promises = Object.entries(DATA_URLS).map(([key, url]) => {\n        return new Promise<void>((resolve) => {\n          Papa.parse(url, {\n            download: true,\n            header: true,\n            dynamicTyping: true,\n            skipEmptyLines: true,\n            complete: (res) => {\n              results[key] = res.data;\n              resolve();\n            },\n            error: () => {\n              results[key] = []; // Fallback on error\n              resolve();\n            }\n          });\n        });\n      });\n\n      await Promise.all(promises);\n      \n      // Post-process the data (combine dates etc as needed or just store raw)\n      setData(results);\n      setLoading(false);\n    };\n\n    fetchAll();\n  }, []);\n\n  return (\n    <div className=\"min-h-screen bg-neutral-50 text-neutral-900 font-sans\">\n      {/* Header */}\n      <header className=\"bg-white border-b border-neutral-200 px-6 py-4 sticky top-0 z-10\">\n        <div className=\"max-w-7xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-4\">\n          <div className=\"flex items-center gap-3\">\n            <h1 className=\"text-2xl font-semibold tracking-tight text-neutral-900\">\n              Bolivia Synthetic CPI Tracker\n            </h1>\n            <div className=\"group relative\">\n              <Info className=\"w-5 h-5 text-neutral-400 cursor-help hover:text-neutral-600 transition-colors\" />\n              <div className=\"absolute left-1/2 -translate-x-1/2 top-full mt-2 w-80 p-4 bg-neutral-900 text-white text-sm rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all pointer-events-none z-50 leading-relaxed font-medium\">\n                The synthetic index uses a matched-model Jevons calculation and explicitly filters out volatile <span className=\"italic\">temporada</span> (seasonal) categories to prevent downward bias.\n              </div>\n            </div>\n          </div>\n          <p className=\"text-sm text-neutral-500 max-w-md md:text-right hidden sm:block\">\n            High-frequency alternative inflation measurement tracking supermarkets across major Bolivian cities.\n          </p>\n        </div>\n      </header>\n\n      {/* Main Content */}\n      <main className=\"max-w-7xl mx-auto px-6 py-8\">\n        \n        {/* Tabs */}\n        <div className=\"flex overflow-x-auto border-b border-neutral-200 mb-8 scrollbar-hide\">\n          {[\n            { id: \'national\', label: \'National Overview\' },\n            { id: \'laPaz\', label: \'La Paz\' },\n            { id: \'cochabamba\', label: \'Cochabamba\' },\n            { id: \'santaCruz\', label: \'Santa Cruz\' },\n            { id: \'productCounts\', label: \'Live Product Count\' },\n          ].map(tab => (\n            <button\n              key={tab.id}\n              onClick={() => setActiveTab(tab.id)}\n              className={`px-4 py-3 text-sm font-medium whitespace-nowrap transition-colors relative ${\n                activeTab === tab.id \n                  ? \'text-sky-600\'\n                  : \'text-neutral-500 hover:text-neutral-800 hover:bg-neutral-100/50 round-t-md\'\n              }`}\n            >\n              {tab.label}\n              {activeTab === tab.id && (\n                <div className=\"absolute bottom-0 left-0 right-0 h-0.5 bg-sky-600 rounded-t-full\" />\n              )}\n            </button>\n          ))}\n        </div>\n\n        {/* Dashboard Views */}\n        {loading ? (\n          <div className=\"flex flex-col items-center justify-center h-[500px] text-neutral-400\">\n            <Loader2 className=\"w-10 h-10 animate-spin mb-4 text-sky-500\" />\n            <p className=\"text-sm font-medium tracking-wide\">Fetching high-frequency data...</p>\n          </div>\n        ) : (\n          <div className=\"bg-white border border-neutral-200 rounded-2xl shadow-sm p-6 lg:p-8\">\n            {activeTab === \'national\' && <NationalView data={data} />}\n            {activeTab === \'laPaz\' && <CityView name=\"La Paz\" syntheticData={data.laPazSynthetic} officialData={data.laPazOfficial} />}\n            {activeTab === \'cochabamba\' && <CityView name=\"Cochabamba\" syntheticData={data.cochabambaSynthetic} officialData={data.cochabambaOfficial} />}\n            {activeTab === \'santaCruz\' && <CityView name=\"Santa Cruz\" syntheticData={data.santaCruzSynthetic} officialData={data.santaCruzOfficial} />}\n            {activeTab === \'productCounts\' && <ProductCountView data={data.productCounts} />}\n          </div>\n        )}\n      </main>\n    </div>\n  );\n}\n\n// -----------------------------------------------------\n// Views\n// -----------------------------------------------------\n\nfunction NationalView({ data }: { data: DataStore }) {\n  const [showLaPaz, setShowLaPaz] = useState(false);\n  const [showCochabamba, setShowCochabamba] = useState(false);\n  const [showSantaCruz, setShowSantaCruz] = useState(false);\n  const [showOfficial, setShowOfficial] = useState(false);\n\n  // Combine synthetic and official data by date\n  // Synthetic is daily (YYYY-MM-DD), Official is monthly (M/D/YY). \n  // Let\'s standardise the date string to plot them together on a timeline\n  const chartData = useMemo(() => {\n    const combined: Record<string, any> = {};\n\n    // 1. Process Synthetic\n    data.nationalSynthetic?.forEach(row => {\n      if (!row.date) return;\n      const d = new Date(row.date);\n      const key = d.toISOString().split(\'T\')[0];\n      combined[key] = {\n        dateNum: d.getTime(), // For sorting\n        displayDate: key,\n        Synthetic_National: row.cpi,\n        Synthetic_LaPaz: row.la_paz_cpi,\n        Synthetic_Cochabamba: row.cochabamba_cpi,\n        Synthetic_SantaCruz: row.santa_cruz_cpi\n      };\n    });\n\n    // 2. Process Official\n    data.nationalOfficial?.forEach(row => {\n      if (!row.Index) return;\n      const d = new Date(row.Index);\n      const key = d.toISOString().split(\'T\')[0];\n      if (!combined[key]) {\n        combined[key] = { dateNum: d.getTime(), displayDate: key };\n      }\n      combined[key].Official_National = row[\'\303\215NDICE GENERAL\'];\n    });\n\n    return Object.values(combined).sort((a, b) => a.dateNum - b.dateNum);\n  }, [data]);\n\n  const downloadCSV = () => {\n    const csv = Papa.unparse(chartData);\n    exportCSV(csv, \'national_cpi_data.csv\');\n  };\n\n  return (\n    <div className=\"flex flex-col h-full\">\n      <div className=\"flex flex-col lg:flex-row lg:items-start justify-between gap-6 mb-8\">\n        <div>\n          <h2 className=\"text-xl font-bold tracking-tight mb-2\">National CPI Trends</h2>\n          <p className=\"text-sm text-neutral-500\">Synthetic trajectory benchmarking against official reports.</p>\n        </div>\n        \n        <div className=\"flex flex-wrap gap-x-6 gap-y-3 p-4 bg-neutral-50 rounded-xl border border-neutral-100\">\n          <label className=\"flex items-center gap-2 cursor-pointer group\">\n            <input type=\"checkbox\" checked={showLaPaz} onChange={e => setShowLaPaz(e.target.checked)} className=\"rounded border-neutral-300 text-rose-500 focus:ring-rose-500 w-4 h-4 cursor-pointer\" />\n            <span className=\"text-sm font-medium select-none group-hover:text-rose-600 transition-colors\">La Paz (Synthetic)</span>\n          </label>\n          <label className=\"flex items-center gap-2 cursor-pointer group\">\n            <input type=\"checkbox\" checked={showCochabamba} onChange={e => setShowCochabamba(e.target.checked)} className=\"rounded border-neutral-300 text-emerald-500 focus:ring-emerald-500 w-4 h-4 cursor-pointer\" />\n            <span className=\"text-sm font-medium select-none group-hover:text-emerald-600 transition-colors\">Cochabamba (Synthetic)</span>\n          </label>\n          <label className=\"flex items-center gap-2 cursor-pointer group\">\n            <input type=\"checkbox\" checked={showSantaCruz} onChange={e => setShowSantaCruz(e.target.checked)} className=\"rounded border-neutral-300 text-amber-500 focus:ring-amber-500 w-4 h-4 cursor-pointer\" />\n            <span className=\"text-sm font-medium select-none group-hover:text-amber-600 transition-colors\">Santa Cruz (Synthetic)</span>\n          </label>\n          <div className=\"w-px h-5 bg-neutral-300 mx-2 hidden sm:block\"></div>\n          <label className=\"flex items-center gap-2 cursor-pointer group\">\n            <input type=\"checkbox\" checked={showOfficial} onChange={e => setShowOfficial(e.target.checked)} className=\"rounded border-neutral-300 text-slate-800 focus:ring-slate-800 w-4 h-4 cursor-pointer\" />\n            <span className=\"text-sm font-semibold select-none group-hover:text-black transition-colors\">Overlay Official Data</span>\n          </label>\n        </div>\n      </div>\n\n      <div className=\"h-[500px] w-full min-w-0\">\n        <ResponsiveContainer width=\"100%\" height=\"100%\">\n          <LineChart data={chartData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>\n            <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#e5e5e5\" />\n            <XAxis dataKey=\"displayDate\" tick={{fontSize: 12, fill: \'#737373\'}} tickMargin={10} minTickGap={30} />\n            <YAxis domain={[\'auto\', \'auto\']} tick={{fontSize: 12, fill: \'#737373\'}} tickMargin={10} />\n            <Tooltip content={<CustomTooltip />} />\n            <Legend wrapperStyle={{ fontSize: \'13px\', paddingTop: \'20px\' }} />\n            \n            <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_National\" name=\"National (Synthetic)\" stroke={COLORS[0]} strokeWidth={3} isAnimationActive={false} />\n            {showLaPaz && <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_LaPaz\" name=\"La Paz (Synthetic)\" stroke={COLORS[1]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            {showCochabamba && <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_Cochabamba\" name=\"Cochabamba (Synthetic)\" stroke={COLORS[2]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            {showSantaCruz && <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_SantaCruz\" name=\"Santa Cruz (Synthetic)\" stroke={COLORS[3]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            \n            {showOfficial && <Line type=\"stepAfter\" dataKey=\"Official_National\" name=\"National (Official INE)\" stroke={OFFICIAL_COLOR} strokeDasharray=\"5 5\" strokeWidth={2.5} dot={{ r: 4, fill: OFFICIAL_COLOR }} isAnimationActive={false} />}\n          </LineChart>\n        </ResponsiveContainer>\n      </div>\n\n      <div className=\"mt-8 flex justify-end\">\n        <button onClick={downloadCSV} className=\"flex items-center gap-2 px-4 py-2 bg-white border border-neutral-300 rounded-lg text-sm font-medium hover:bg-neutral-50 transition-colors shadow-sm text-neutral-700\">\n          <Download className=\"w-4 h-4\" /> Export CSV\n        </button>\n      </div>\n    </div>\n  );\n}\n\n\nfunction CityView({ name, syntheticData, officialData }: { name: string, syntheticData: any[], officialData: any[] }) {\n  const [showOfficial, setShowOfficial] = useState(false);\n  const [activeCategories, setActiveCategories] = useState<Record<string, boolean>>({});\n\n  // Extract categories dynamically\n  const categories = useMemo(() => {\n    if (!syntheticData || syntheticData.length === 0) return [];\n    const keys = Object.keys(syntheticData[0]);\n    // Filter out date and main cpi\n    return keys.filter(k => k !== \'date\' && k !== \'cpi\');\n  }, [syntheticData]);\n\n  // Combined data\n  const chartData = useMemo(() => {\n    const combined: Record<string, any> = {};\n\n    syntheticData?.forEach(row => {\n      if (!row.date) return;\n      const d = new Date(row.date);\n      const key = d.toISOString().split(\'T\')[0];\n      combined[key] = {\n        dateNum: d.getTime(),\n        displayDate: key,\n        Synthetic_CPI: row.cpi,\n        ...row // Spread other categories in\n      };\n    });\n\n    officialData?.forEach(row => {\n      if (!row.Index) return;\n      const d = new Date(row.Index);\n      const key = d.toISOString().split(\'T\')[0];\n      if (!combined[key]) combined[key] = { dateNum: d.getTime(), displayDate: key };\n      combined[key].Official_CPI = row[\'\303\215NDICE GENERAL\'] || row[\'\303\215NDICE\']; // Handling varying headers\n    });\n\n    return Object.values(combined).sort((a, b) => a.dateNum - b.dateNum);\n  }, [syntheticData, officialData]);\n\n  const downloadCSV = () => {\n    const csv = Papa.unparse(chartData);\n    exportCSV(csv, `${name.toLowerCase().replace(\' \', \'_\')}_cpi_data.csv`);\n  };\n\n  const toggleCategory = (cat: string) => {\n    setActiveCategories(prev => ({ ...prev, [cat]: !prev[cat] }));\n  };\n\n  return (\n    <div className=\"flex flex-col h-full\">\n      <div className=\"flex flex-col lg:flex-row justify-between gap-6 mb-8\">\n        <div>\n          <h2 className=\"text-xl font-bold tracking-tight mb-2\">{name} CPI Breakdown</h2>\n          <p className=\"text-sm text-neutral-500\">Top-line general index with optional category sub-indices.</p>\n        </div>\n        \n        <label className=\"flex items-center gap-2 cursor-pointer group px-4 py-2 bg-slate-100 rounded-lg border border-slate-200 self-start\">\n          <input type=\"checkbox\" checked={showOfficial} onChange={e => setShowOfficial(e.target.checked)} className=\"rounded border-slate-400 text-slate-800 w-4 h-4 cursor-pointer\" />\n          <span className=\"text-sm font-semibold text-slate-800 select-none\">Overlay Official {name} Data</span>\n        </label>\n      </div>\n\n      {categories.length > 0 && (\n        <div className=\"mb-6\">\n          <p className=\"text-xs font-semibold text-neutral-400 uppercase tracking-wider mb-3\">Sub-Categories</p>\n          <div className=\"flex flex-wrap gap-2\">\n            {categories.map((cat, i) => {\n              const active = activeCategories[cat];\n              const color = COLORS[(i + 1) % COLORS.length]; \n              return (\n                <button\n                  key={cat}\n                  onClick={() => toggleCategory(cat)}\n                  className={`text-xs px-3 py-1.5 rounded-full border transition-all ${\n                    active \n                      ? \'bg-neutral-800 text-white border-neutral-800 shadow-sm\' \n                      : \'bg-white text-neutral-600 border-neutral-200 hover:border-neutral-300\'\n                  }`}\n                >\n                  <span className=\"flex items-center gap-2\">\n                    {active && <span className=\"w-2 h-2 rounded-full\" style={{backgroundColor: color}} />}\n                    {cat}\n                  </span>\n                </button>\n              );\n            })}\n          </div>\n        </div>\n      )}\n\n      <div className=\"h-[500px] w-full min-w-0\">\n        <ResponsiveContainer width=\"100%\" height=\"100%\">\n          <LineChart data={chartData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>\n            <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#e5e5e5\" />\n            <XAxis dataKey=\"displayDate\" tick={{fontSize: 12, fill: \'#737373\'}} tickMargin={10} minTickGap={30} />\n            <YAxis domain={[\'auto\', \'auto\']} tick={{fontSize: 12, fill: \'#737373\'}} tickMargin={10} />\n            <Tooltip content={<CustomTooltip />} />\n            <Legend wrapperStyle={{ fontSize: \'13px\', paddingTop: \'20px\' }} />\n            \n            <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_CPI\" name={`${name} General (Synthetic)`} stroke={COLORS[0]} strokeWidth={3} isAnimationActive={false} />\n            \n            {showOfficial && <Line type=\"stepAfter\" dataKey=\"Official_CPI\" name={`${name} General (Official INE)`} stroke={OFFICIAL_COLOR} strokeDasharray=\"5 5\" strokeWidth={2.5} dot={{ r: 4, fill: OFFICIAL_COLOR }} isAnimationActive={false} />}\n\n            {categories.map((cat, i) => {\n              if (!activeCategories[cat]) return null;\n              return <Line key={cat} type=\"monotone\" dot={false} dataKey={cat} name={cat} stroke={COLORS[(i + 1) % COLORS.length]} strokeWidth={1.5} opacity={0.6} isAnimationActive={false} />;\n            })}\n          </LineChart>\n        </ResponsiveContainer>\n      </div>\n\n      <div className=\"mt-8 flex justify-end\">\n        <button onClick={downloadCSV} className=\"flex items-center gap-2 px-4 py-2 bg-white border border-neutral-300 rounded-lg text-sm font-medium hover:bg-neutral-50 transition-colors shadow-sm text-neutral-700\">\n          <Download className=\"w-4 h-4\" /> Export CSV\n        </button>\n      </div>\n    </div>\n  );\n}\n\n\nfunction ProductCountView({ data }: { data: any[] }) {\n  const chartData = useMemo(() => {\n    if (!data) return [];\n    return data.map(r => {\n      // Date comes as MM/DD/YY or similar\n      const d = new Date(r.Date);\n      return {\n        ...r,\n        dateNum: d.getTime(),\n        displayDate: d.toISOString().split(\'T\')[0]\n      };\n    }).sort((a,b) => a.dateNum - b.dateNum);\n  }, [data]);\n\n  const categories = useMemo(() => {\n    if (chartData.length === 0) return [];\n    return Object.keys(chartData[0]).filter(k => k !== \'Date\' && k !== \'dateNum\' && k !== \'displayDate\');\n  }, [chartData]);\n\n  const downloadCSV = () => {\n    const csv = Papa.unparse(chartData.map(r => {\n      const {dateNum, ...rest} = r;\n      return rest;\n    }));\n    exportCSV(csv, \'live_product_counts.csv\');\n  };\n\n  return (\n    <div className=\"flex flex-col h-full\">\n      <div className=\"mb-8\">\n        <h2 className=\"text-xl font-bold tracking-tight mb-2\">Live Product Count</h2>\n        <p className=\"text-sm text-neutral-500\">Volume of products tracked daily across different categories.</p>\n      </div>\n\n      <div className=\"h-[500px] w-full min-w-0\">\n        <ResponsiveContainer width=\"100%\" height=\"100%\">\n          <AreaChart data={chartData} margin={{ top: 10, right: 10, left: -10, bottom: 0 }}>\n            <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#e5e5e5\" />\n            <XAxis dataKey=\"displayDate\" tick={{fontSize: 12, fill: \'#737373\'}} tickMargin={10} minTickGap={30} />\n            <YAxis tick={{fontSize: 12, fill: \'#737373\'}} tickMargin={10} />\n            <Tooltip content={<CustomTooltip />} />\n            <Legend wrapperStyle={{ fontSize: \'13px\', paddingTop: \'20px\' }} />\n            \n            {categories.map((cat, i) => (\n              <Area \n                key={cat} \n                type=\"monotone\" \n                dataKey={cat} \n                stackId=\"1\" \n                stroke={COLORS[i % COLORS.length]} \n                fill={COLORS[i % COLORS.length]} \n                isAnimationActive={false}\n                fillOpacity={0.8}\n              />\n            ))}\n          </AreaChart>\n        </ResponsiveContainer>\n      </div>\n\n      <div className=\"mt-8 flex justify-end\">\n        <button onClick={downloadCSV} className=\"flex items-center gap-2 px-4 py-2 bg-white border border-neutral-300 rounded-lg text-sm font-medium hover:bg-neutral-50 transition-colors shadow-sm text-neutral-700\">\n          <Download className=\"w-4 h-4\" /> Export CSV\n        </button>\n      </div>\n    </div>\n  );\n}\n\n\n// -----------------------------------------------------\n// Utils\n// -----------------------------------------------------\n\nfunction exportCSV(csvContent: string, filename: string) {\n  const blob = new Blob([csvContent], { type: \'text/csv;charset=utf-8;\' });\n  const link = document.createElement(\'a\');\n  if (link.download !== undefined) {\n    const url = URL.createObjectURL(blob);\n    link.setAttribute(\'href\', url);\n    link.setAttribute(\'download\', filename);\n    link.style.visibility = \'hidden\';\n    document.body.appendChild(link);\n    link.click();\n    document.body.removeChild(link);\n  }\n}\n\nfunction CustomTooltip({ active, payload, label }: any) {\n  if (active && payload && payload.length) {\n    return (\n      <div className=\"bg-white border border-neutral-200 p-4 rounded-xl shadow-xl z-50 min-w-[200px]\">\n        <p className=\"font-medium text-neutral-900 border-b border-neutral-100 pb-2 mb-3\">{label}</p>\n        <div className=\"space-y-2\">\n          {payload.map((p: any, idx: number) => (\n            <div key={idx} className=\"flex items-center justify-between gap-4 text-sm\">\n              <div className=\"flex items-center gap-2\">\n                <span className=\"w-2.5 h-2.5 rounded-full\" style={{ backgroundColor: p.stroke || p.fill }} />\n                <span className=\"text-neutral-600 truncate max-w-[180px]\">{p.name}</span>\n              </div>\n              <span className=\"font-semibold font-mono text-neutral-900 tabular-nums\">\n                {typeof p.value === \'number\' ? p.value.toLocaleString(undefined, { minimumFractionDigits: 2, maximumFractionDigits: 2 }) : p.value}\n              </span>\n            </div>\n          ))}\n        </div>\n      </div>\n    );\n  }\n  return null;\n}\n"
      }
      num_matches: 1
    }
  }
}
