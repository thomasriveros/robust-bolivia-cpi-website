    instruction: "Add showOfficialOverall state, process nationalOfficialOverall data, and update active keys"
    replacement_infos {
      original_chunk {
        target_content: "  const [showCochabamba, setShowCochabamba] = useState(false);\n  const [showSantaCruz, setShowSantaCruz] = useState(false);\n  const [showOfficial, setShowOfficial] = useState(false);\n  const [inflationMode, setInflationMode] = useState<InflationMode>(\'DOD\');\n\n  // Combine synthetic and official data by date\n  // Synthetic is daily (YYYY-MM-DD), Official is monthly (M/D/YY). \n  // Let\'s standardise the date string to plot them together on a timeline\n  const chartData = useMemo(() => {\n    const combined: Record<string, any> = {};\n\n    // 1. Process Synthetic\n    data.nationalSynthetic?.forEach(row => {\n      if (!row.date) return;\n      const d = new Date(row.date);\n      const key = d.toISOString().split(\'T\')[0];\n      combined[key] = {\n        dateNum: d.getTime(), // For sorting\n        displayDate: key,\n        Synthetic_National: row.cpi,\n        Synthetic_LaPaz: row.la_paz_cpi,\n        Synthetic_Cochabamba: row.cochabamba_cpi,\n        Synthetic_SantaCruz: row.santa_cruz_cpi,\n        data_source: row.data_source,\n        forwardFillMarker: row.data_source === \'Forward Fill\' ? 3 : 0\n      };\n    });\n\n    // 2. Process Official\n    let firstOfficialValue: number | null = null;\n    const sortedOfficial = [...(data.nationalOfficial || [])].sort((a, b) => {\n      const dateA = a.Date || a.Index;\n      const dateB = b.Date || b.Index;\n      return new Date(dateA).getTime() - new Date(dateB).getTime();\n    });\n\n    sortedOfficial.forEach(row => {\n      const dateStr = row.Date || row.Index;\n      if (!dateStr) return;\n      const d = new Date(dateStr);\n      const key = d.toISOString().split(\'T\')[0];\n      if (!combined[key]) {\n        combined[key] = { dateNum: d.getTime(), displayDate: key };\n      }\n      const val = row[\'CPI Equ. Basket\'] || row[\'\303\215NDICE GENERAL\'];\n      if (typeof val === \'number\') {\n        if (firstOfficialValue === null) firstOfficialValue = val;\n        combined[key].Official_National = firstOfficialValue ? (val / firstOfficialValue) * 100 : val;\n      }\n    });\n\n    return Object.values(combined).sort((a, b) => a.dateNum - b.dateNum);\n  }, [data]);\n\n  const activeKeys = useMemo(() => {\n    const keys = [\'Synthetic_National\'];\n    if (showLaPaz) keys.push(\'Synthetic_LaPaz\');\n    if (showCochabamba) keys.push(\'Synthetic_Cochabamba\');\n    if (showSantaCruz) keys.push(\'Synthetic_SantaCruz\');\n    if (showOfficial) keys.push(\'Official_National\');\n    return keys;\n  }, [showLaPaz, showCochabamba, showSantaCruz, showOfficial]);"
        replacement_content: "  const [showCochabamba, setShowCochabamba] = useState(false);\n  const [showSantaCruz, setShowSantaCruz] = useState(false);\n  const [showOfficial, setShowOfficial] = useState(false);\n  const [showOfficialOverall, setShowOfficialOverall] = useState(false);\n  const [inflationMode, setInflationMode] = useState<InflationMode>(\'DOD\');\n\n  // Combine synthetic and official data by date\n  // Synthetic is daily (YYYY-MM-DD), Official is monthly (M/D/YY). \n  // Let\'s standardise the date string to plot them together on a timeline\n  const chartData = useMemo(() => {\n    const combined: Record<string, any> = {};\n\n    // 1. Process Synthetic\n    data.nationalSynthetic?.forEach(row => {\n      if (!row.date) return;\n      const d = new Date(row.date);\n      const key = d.toISOString().split(\'T\')[0];\n      combined[key] = {\n        dateNum: d.getTime(), // For sorting\n        displayDate: key,\n        Synthetic_National: row.cpi,\n        Synthetic_LaPaz: row.la_paz_cpi,\n        Synthetic_Cochabamba: row.cochabamba_cpi,\n        Synthetic_SantaCruz: row.santa_cruz_cpi,\n        data_source: row.data_source,\n        forwardFillMarker: row.data_source === \'Forward Fill\' ? 3 : 0\n      };\n    });\n\n    // 2. Process Official\n    let firstOfficialValue: number | null = null;\n    const sortedOfficial = [...(data.nationalOfficial || [])].sort((a, b) => {\n      const dateA = a.Date || a.Index;\n      const dateB = b.Date || b.Index;\n      return new Date(dateA).getTime() - new Date(dateB).getTime();\n    });\n\n    sortedOfficial.forEach(row => {\n      const dateStr = row.Date || row.Index;\n      if (!dateStr) return;\n      const d = new Date(dateStr);\n      const key = d.toISOString().split(\'T\')[0];\n      if (!combined[key]) {\n        combined[key] = { dateNum: d.getTime(), displayDate: key };\n      }\n      const val = row[\'CPI Equ. Basket\'] || row[\'\303\215NDICE GENERAL\'];\n      if (typeof val === \'number\') {\n        if (firstOfficialValue === null) firstOfficialValue = val;\n        combined[key].Official_National = firstOfficialValue ? (val / firstOfficialValue) * 100 : val;\n      }\n    });\n\n    // 3. Process Official Overall\n    let firstOfficialOverallValue: number | null = null;\n    const sortedOfficialOverall = [...(data.nationalOfficialOverall || [])].sort((a, b) => {\n      const dateA = a.Date || a.Index;\n      const dateB = b.Date || b.Index;\n      return new Date(dateA).getTime() - new Date(dateB).getTime();\n    });\n\n    sortedOfficialOverall.forEach(row => {\n      const dateStr = row.Date || row.Index;\n      if (!dateStr) return;\n      const d = new Date(dateStr);\n      const key = d.toISOString().split(\'T\')[0];\n      if (!combined[key]) {\n        combined[key] = { dateNum: d.getTime(), displayDate: key };\n      }\n      const val = row[\'\303\215NDICE GENERAL\'] || row[\'\303\215NDICE\'] || row[\'CPI Equ. Basket\'];\n      if (typeof val === \'number\') {\n        if (firstOfficialOverallValue === null) firstOfficialOverallValue = val;\n        combined[key].Official_National_Overall = firstOfficialOverallValue ? (val / firstOfficialOverallValue) * 100 : val;\n      }\n    });\n\n    return Object.values(combined).sort((a, b) => a.dateNum - b.dateNum);\n  }, [data]);\n\n  const activeKeys = useMemo(() => {\n    const keys = [\'Synthetic_National\'];\n    if (showLaPaz) keys.push(\'Synthetic_LaPaz\');\n    if (showCochabamba) keys.push(\'Synthetic_Cochabamba\');\n    if (showSantaCruz) keys.push(\'Synthetic_SantaCruz\');\n    if (showOfficial) keys.push(\'Official_National\');\n    if (showOfficialOverall) keys.push(\'Official_National_Overall\');\n    return keys;\n  }, [showLaPaz, showCochabamba, showSantaCruz, showOfficial, showOfficialOverall]);"
      }
      num_matches: 1
    }
  }
}
