        }
        lines {
          text: "      const dateB = b.Date || b.Index;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      return new Date(dateA).getTime() - new Date(dateB).getTime();"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
