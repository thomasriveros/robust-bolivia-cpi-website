aCruzSynthetic} officialData={data.santaCruzOfficial} />`, `<CityView name=\"Santa Cruz\" syntheticData={data.santaCruzSynthetic} officialData={data.santaCruzOfficial} lang={lang} t={t} />`);\ncode = code.replace(`<ProductCountView data={data.productCounts} />`, `<ProductCountView data={data.productCounts} lang={lang} t={t} />`);\ncode = code.replace(`<MethodologyView />`, `<MethodologyView lang={lang} t={t} />`);\n\n// NationalView translations\ncode = code.replace(`>National CPI Trends<`, `>{t.national.title}<`);\ncode = code.replace(`>This synthetic index covers ~49% of the official INE CPI basket (Core-5 retail categories). It is a high-frequency benchmark, not a comprehensive national CPI.<`, `>{t.national.desc}<`);\ncode = code.replace(/>La Paz \\(Synthetic\\)</g, `>{t.national.laPazSync}<`);\ncode = code.replace(/>Cochabamba \\(Synthetic\\)</g, `>{t.national.cochabambaSync}<`);\ncode = code.replace(/>Santa Cruz \\(Synthetic\\)</g, `>{t.national.santaCruzSync}<`);\ncode = code.replace(`Overlay Official Data \"5-Core\" Categories`, `{t.national.overlayOfficial}`);\ncode = code.replace(`>CPI Timeline<`, `>{t.national.cpiTimeline}<`);\ncode = code.replace(/name=\"National \\(Synthetic\\)\"/g, `name={t.national.nationalSyncName}`);\ncode = code.replace(/name=\"La Paz \\(Synthetic\\)\"/g, `name={t.national.laPazSyncName}`);\ncode = code.replace(/name=\"Cochabamba \\(Synthetic\\)\"/g, `name={t.national.cochabambaSyncName}`);\ncode = code.replace(/name=\"Santa Cruz \\(Synthetic\\)\"/g, `name={t.national.santaCruzSyncName}`);\ncode = code.replace(/name=\"National \\(Official INE\\)\"/g, `name={t.national.nationalOfficialName}`);\ncode = code.replace(`>Inflation Rate (%)<`, `>{t.national.inflationRate}<`);\ncode = code.replace(`Export CSV`, `{t.national.exportCSV}`);\n\n\n// CityView\ncode = code.replace(/>\\{name\\} CPI Breakdown</g, `>{name}{t.city.titleSuffix}<`);\ncode = code.replace(`Top-line general index with optional category sub-indices.`, `{t.city.desc}`);\ncode = code.replace(`Overlay Official {name} Data`, `{t.city.overlayOfficialPart1}{name}{t.city.overlayOfficialPart2}`);\ncode = code.replace(`>Sub-Categories<`, `>{t.city.subCategories}<`);\ncode = code.replace(`>CPI Timeline<`, `>{t.city.cpiTimeline}<`);\ncode = code.replace(/name=\\{\\`\\$\\{name\\} General \\(Synthetic\\)\\`\\}/g, `name={\\`\\$\\{name\\}\\$\\{t.city.generalSynthetic\\}\\`}`);\ncode = code.replace(/name=\\{\\`\\$\\{name\\} General \\(Official INE\\)\\`\\}/g, `name={\\`\\$\\{name\\}\\$\\{t.city.generalOfficial\\}\\`}`);\ncode = code.replace(/name=\\{\\`\\$\\{cat\\} \\(Official\\)\\`\\}/g, `name={\\`\\$\\{cat\\}\\$\\{t.city.officialSuffix\\}\\`}`);\ncode = code.replace(`>Inflation Rate (%)<`, `>{t.city.inflationRate}<`);\ncode = code.replace(`Export CSV`, `{t.city.exportCSV}`);\n\n// ProductCountView\ncode = code.replace(`>Live Product Count<`, `>{t.counts.title}<`);\ncode = code.replace(`Total number of price observations across all three cities combined (La Paz, Cochabamba, and Santa Cruz)`, `{t.counts.desc}`);\ncode = code.replace(`Export CSV`, `{t.counts.exportCSV}`);\n\n// MethodologyView\ncode = code.replace(`>Methodology<`, `>{t.methodology.title}<`);\ncode = code.replace(`Read about our data collection and calculation methodology. Since PDF previews can sometimes be blocked by browser security settings in this preview environment, please download or open the document directly.`, `{t.methodology.desc}`);\ncode = code.replace(`Download PDF`, `{t.methodology.downloadPDF}`);\ncode = code.replace(`Open in New Tab`, `{t.methodology.openNewTab}`);\n\n// Tooltip\ncode = code.replace(/name=\"Forward Fill Date\"/g, `name=\"ForwardFillDateToken\"`);\ncode = code.replace(`(Forward Fill)`, `{t.forwardFillShort}`);\ncode = code.replace(`function CustomTooltip({ active, payload, label, isPercent }: any) {`, `function CustomTooltip({ active, payload, label, isPercent, t }: any) {`);\ncode = code.replace(`content={<CustomTooltip />`, `content={<CustomTooltip