    replacement_infos {
      original_chunk {
        target_content: "  const downloadCSV = () => {\n    const allKeys = [\'Synthetic_CPI\', \'Official_CPI\'];\n    for (const cat of categories) {\n      allKeys.push(cat);\n      allKeys.push(`Official_${cat}`);\n    }\n    const fullInflationData = calculateInflationData(chartData, allKeys, inflationMode);\n    \n    const exportData = fullInflationData.map(row => {\n      const expRow: any = { Date: row.displayDate };\n      if (row.data_source) expRow.DataSource = row.data_source;\n      for (const key of allKeys) {\n        if (row[key] !== undefined) expRow[key] = row[key];\n        const infKey = `${key}_Inflation`;\n        if (row[infKey] !== undefined) expRow[infKey] = row[infKey];\n      }\n      return expRow;\n    });\n    const csv = Papa.unparse(exportData);\n    exportCSV(csv, `${name.toLowerCase().replace(\' \', \'_\')}_cpi_data.csv`);\n  };"
        replacement_content: "  const downloadCSV = () => {\n    const allKeys = [\'Synthetic_CPI\', \'Official_CPI\'];\n    for (const cat of categories) {\n      allKeys.push(cat);\n      allKeys.push(`Official_${cat}`);\n    }\n    const fullInflationData = calculateInflationData(chartData, allKeys, inflationMode);\n    \n    const exportData = fullInflationData.map(row => {\n      const expRow: any = { Date: row.displayDate, DataSource: row.data_source ?? null };\n      for (const key of allKeys) {\n        expRow[key] = row[key] ?? null;\n        const infKey = `${key}_Inflation`;\n        expRow[infKey] = row[infKey] ?? null;\n      }\n      return expRow;\n    });\n    const csv = Papa.unparse(exportData);\n    exportCSV(csv, `${name.toLowerCase().replace(\' \', \'_\')}_cpi_data.csv`);\n  };"
      }
      num_matches: 1
    }
  }
