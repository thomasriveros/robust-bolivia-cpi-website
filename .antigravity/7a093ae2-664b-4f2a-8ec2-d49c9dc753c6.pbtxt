        }
        lines {
          text: "function CityView({ name, syntheticData, officialData }: { name: string, syntheticData: any[], officialData: any[] }) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [showOfficial, setShowOfficial] = useState(false);"
