e=\"flex bg-neutral-100 p-1 rounded-lg\">\n            {([\'DOD\', \'MOM\', \'YOY\'] as const).map(mode => (\n              <button\n                key={mode}\n                onClick={() => setInflationMode(mode)}\n                className={`px-3 py-1.5 text-xs font-semibold rounded-md transition-shadow transition-colors ${inflationMode === mode ? \'bg-white shadow-sm text-sky-600\' : \'text-neutral-500 hover:text-neutral-700\'}`}\n              >\n                {mode}\n              </button>\n            ))}\n          </div>\n        </div>\n        <ResponsiveContainer width=\"100%\" height=\"100%\">\n          <LineChart data={inflationData} margin={{ top: 10, right: 10, left: -20, bottom: 0 }}>\n            <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#e5e5e5\" />\n            <XAxis dataKey=\"displayDate\" tick={{fontSize: 12, fill: \'#737373\'}} tickMargin={10} minTickGap={30} />\n            <YAxis tick={{fontSize: 12, fill: \'#737373\'}} tickMargin={10} tickFormatter={(val) => val.toFixed(1) + \'%\'} />\n            <Tooltip content={<CustomTooltip isPercent />} />\n            <Legend wrapperStyle={{ fontSize: \'13px\', paddingTop: \'20px\' }} />\n            \n            <Line type=\"stepAfter\" dot={false} dataKey=\"Synthetic_CPI_Inflation\" name={`${name} General (Synthetic)`} stroke={COLORS[0]} strokeWidth={3} isAnimationActive={false} />\n            \n            {showOfficial && <Line type=\"linear\" connectNulls={true} dataKey=\"Official_CPI_Inflation\" name={`${name} General (Official INE)`} stroke={OFFICIAL_COLOR} strokeDasharray=\"5 5\" strokeWidth={2.5} dot={{ r: 4, fill: OFFICIAL_COLOR }} isAnimationActive={false} />}\n\n            {categories.map((cat, i) => {\n              if (!activeCategories[cat]) return null;\n              return <Line key={cat} type=\"stepAfter\" dot={false} dataKey={`${cat}_Inflation`} name={cat} stroke={COLORS[(i + 1) % COLORS.length]} strokeWidth={1.5} opacity={0.6} isAnimationActive={fa