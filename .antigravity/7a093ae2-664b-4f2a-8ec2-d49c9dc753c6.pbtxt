        }
        lines {
          text: "function CityView({ name, syntheticData, officialData, lang, t }: { name: string, syntheticData: any[], officialData: any[], lang: Lang, t: typeof T[\'en\'] }) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [showOfficial, setShowOfficial] = useState(false);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [activeCategories, setActiveCategories] = useState<Record<string, boolean>>({});"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [inflationMode, setInflationMode] = useState<InflationMode>(\'DOD\');"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // Extract categories dynamically"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const categories = useMemo(() => {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    if (!syntheticData || syntheticData.length === 0) return [\'Prendas de Vestir y Calzado\'];"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const keys = Object.keys(syntheticData[0]);"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    // Filter out date and main cpi"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
