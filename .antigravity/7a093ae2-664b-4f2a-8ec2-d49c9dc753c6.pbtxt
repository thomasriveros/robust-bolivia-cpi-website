    replacement_infos {
      original_chunk {
        target_content: "          <div className=\"w-px h-5 bg-neutral-300 mx-2 hidden sm:block\"></div>\n          <label className=\"flex items-center gap-2 cursor-pointer group\">\n            <input type=\"checkbox\" checked={showOfficial} onChange={e => setShowOfficial(e.target.checked)} className=\"rounded border-neutral-300 text-slate-800 focus:ring-slate-800 w-4 h-4 cursor-pointer\" />\n            <span className=\"text-sm font-semibold select-none group-hover:text-black transition-colors\">{t.national.overlayOfficial}</span>\n          </label>\n        </div>\n      </div>\n\n      <div className=\"h-[400px] w-full min-w-0 mb-8 border-b border-neutral-100 pb-8\">\n        <h3 className=\"text-sm font-semibold text-neutral-500 uppercase tracking-wider mb-4\">{t.national.cpiTimeline}</h3>\n        <ResponsiveContainer width=\"100%\" height=\"100%\">\n          <ComposedChart syncId=\"nationalSync\" data={inflationData} margin={{ top: 10, right: 10, left: 0, bottom: 0 }}>\n            <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#e5e5e5\" />\n            <XAxis dataKey=\"displayDate\" tick={{fontSize: 12, fill: \'#737373\', fontFamily: \'var(--font-mono)\'}} tickMargin={10} minTickGap={30} />\n            <YAxis domain={[\'auto\', \'auto\']} tick={{fontSize: 12, fill: \'#737373\', fontFamily: \'var(--font-mono)\'}} tickMargin={10} />\n            <YAxis yAxisId=\"marker\" domain={[0, 100]} hide />\n            <Bar yAxisId=\"marker\" dataKey=\"forwardFillMarker\" name=\"ForwardFillDateToken\" fill=\"#fb923c\" isAnimationActive={false} barSize={4} />\n            <Tooltip content={<CustomTooltip t={t} />} />\n            <Legend wrapperStyle={{ fontSize: \'13px\', paddingTop: \'20px\' }} />\n            \n            <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_National\" name={t.national.nationalSyncName} stroke={COLORS[0]} strokeWidth={3} isAnimationActive={false} />\n            {showLaPaz && <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_LaPaz\" name={t.national.laPazSyncName} stroke={COLORS[1]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            {showCochabamba && <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_Cochabamba\" name={t.national.cochabambaSyncName} stroke={COLORS[2]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            {showSantaCruz && <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_SantaCruz\" name={t.national.santaCruzSyncName} stroke={COLORS[3]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            \n            {showOfficial && <Line type=\"linear\" connectNulls={true} dataKey=\"Official_National\" name={t.national.nationalOfficialName} stroke={OFFICIAL_COLOR} strokeDasharray=\"5 5\" strokeWidth={2.5} dot={{ r: 4, fill: OFFICIAL_COLOR }} isAnimationActive={false} />}\n          </ComposedChart>\n        </ResponsiveContainer>\n      </div>\n\n      <div className=\"h-[400px] w-full min-w-0\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <h3 className=\"text-sm font-semibold text-neutral-500 uppercase tracking-wider\">{t.national.inflationRate}</h3>\n          <div className=\"flex bg-white/40 backdrop-blur-md p-1 rounded-xl border border-white/50 shadow-sm\">\n            {([\'DOD\', \'MOM\', \'YOY\'] as const).map(mode => (\n              <button\n                key={mode}\n                onClick={() => setInflationMode(mode)}\n                className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all ${inflationMode === mode ? \'bg-white shadow-sm text-sky-600 border border-white/60\' : \'text-neutral-500 hover:text-neutral-700 hover:bg-white/20\'}`}\n              >\n                {mode}\n              </button>\n            ))}\n          </div>\n        </div>\n        <ResponsiveContainer width=\"100%\" height=\"100%\">\n          <ComposedChart syncId=\"nationalSync\" data={inflationData} margin={{ top: 10, right: 10, left: 10, bottom: 0 }}>\n            <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#e5e5e5\" />\n            <XAxis dataKey=\"displayDate\" tick={{fontSize: 12, fill: \'#737373\', fontFamily: \'var(--font-mono)\'}} tickMargin={10} minTickGap={30} />\n            <YAxis tick={{fontSize: 12, fill: \'#737373\', fontFamily: \'var(--font-mono)\'}} tickMargin={10} tickFormatter={(val) => val.toFixed(1) + \'%\'} />\n            <YAxis yAxisId=\"marker\" domain={[0, 100]} hide />\n            <Bar yAxisId=\"marker\" dataKey=\"forwardFillMarker\" name=\"ForwardFillDateToken\" fill=\"#fb923c\" isAnimationActive={false} barSize={4} />\n            <Tooltip content={<CustomTooltip isPercent t={t} />} />\n            <Legend wrapperStyle={{ fontSize: \'13px\', paddingTop: \'20px\' }} />\n            \n            <Line type=\"stepAfter\" dot={false} dataKey=\"Synthetic_National_Inflation\" name={t.national.nationalSyncName} stroke={COLORS[0]} strokeWidth={3} isAnimationActive={false} />\n            {showLaPaz && <Line type=\"stepAfter\" dot={false} dataKey=\"Synthetic_LaPaz_Inflation\" name={t.national.laPazSyncName} stroke={COLORS[1]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            {showCochabamba && <Line type=\"stepAfter\" dot={false} dataKey=\"Synthetic_Cochabamba_Inflation\" name={t.national.cochabambaSyncName} stroke={COLORS[2]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            {showSantaCruz && <Line type=\"stepAfter\" dot={false} dataKey=\"Synthetic_SantaCruz_Inflation\" name={t.national.santaCruzSyncName} stroke={COLORS[3]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            \n            {showOfficial && <Line type=\"linear\" connectNulls={true} dataKey=\"Official_National_Inflation\" name={t.national.nationalOfficialName} stroke={OFFICIAL_COLOR} strokeDasharray=\"5 5\" strokeWidth={2.5} dot={{ r: 4, fill: OFFICIAL_COLOR }} isAnimationActive={false} />}\n            <Brush dataKey=\"displayDate\" height={30} stroke=\"#cbd5e1\" tick={{fontSize: 12, fill: \'#737373\', fontFamily: \'var(--font-mono)\'}} />\n          </ComposedChart>\n        </ResponsiveContainer>"
        replacement_content: "          <div className=\"w-px h-5 bg-neutral-300 mx-2 hidden sm:block\"></div>\n          <label className=\"flex items-center gap-2 cursor-pointer group\">\n            <input type=\"checkbox\" checked={showOfficial} onChange={e => setShowOfficial(e.target.checked)} className=\"rounded border-neutral-300 text-slate-800 focus:ring-slate-800 w-4 h-4 cursor-pointer\" />\n            <span className=\"text-sm font-semibold select-none group-hover:text-black transition-colors\">{t.national.overlayOfficial}</span>\n          </label>\n          <label className=\"flex items-center gap-2 cursor-pointer group\">\n            <input type=\"checkbox\" checked={showOfficialOverall} onChange={e => setShowOfficialOverall(e.target.checked)} className=\"rounded border-neutral-300 text-slate-800 focus:ring-slate-800 w-4 h-4 cursor-pointer\" />\n            <span className=\"text-sm font-semibold select-none group-hover:text-black transition-colors\">{t.national.overlayOfficialOverall}</span>\n          </label>\n        </div>\n      </div>\n\n      <div className=\"h-[400px] w-full min-w-0 mb-8 border-b border-neutral-100 pb-8\">\n        <h3 className=\"text-sm font-semibold text-neutral-500 uppercase tracking-wider mb-4\">{t.national.cpiTimeline}</h3>\n        <ResponsiveContainer width=\"100%\" height=\"100%\">\n          <ComposedChart syncId=\"nationalSync\" data={inflationData} margin={{ top: 10, right: 10, left: 10, bottom: 0 }}>\n            <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#e5e5e5\" />\n            <XAxis dataKey=\"displayDate\" tick={{fontSize: 12, fill: \'#737373\', fontFamily: \'var(--font-mono)\'}} tickMargin={10} minTickGap={30} />\n            <YAxis domain={[\'auto\', \'auto\']} tick={{fontSize: 12, fill: \'#737373\', fontFamily: \'var(--font-mono)\'}} tickMargin={10} />\n            <YAxis yAxisId=\"marker\" domain={[0, 100]} hide />\n            <Bar yAxisId=\"marker\" dataKey=\"forwardFillMarker\" name=\"ForwardFillDateToken\" fill=\"#fb923c\" isAnimationActive={false} barSize={4} />\n            <Tooltip content={<CustomTooltip t={t} />} />\n            <Legend wrapperStyle={{ fontSize: \'13px\', paddingTop: \'20px\' }} />\n            \n            <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_National\" name={t.national.nationalSyncName} stroke={COLORS[0]} strokeWidth={3} isAnimationActive={false} />\n            {showLaPaz && <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_LaPaz\" name={t.national.laPazSyncName} stroke={COLORS[1]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            {showCochabamba && <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_Cochabamba\" name={t.national.cochabambaSyncName} stroke={COLORS[2]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            {showSantaCruz && <Line type=\"monotone\" dot={false} dataKey=\"Synthetic_SantaCruz\" name={t.national.santaCruzSyncName} stroke={COLORS[3]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            \n            {showOfficial && <Line type=\"linear\" connectNulls={true} dataKey=\"Official_National\" name={t.national.nationalOfficialName} stroke={OFFICIAL_COLOR} strokeDasharray=\"5 5\" strokeWidth={2.5} dot={{ r: 4, fill: OFFICIAL_COLOR }} isAnimationActive={false} />}\n            {showOfficialOverall && <Line type=\"linear\" connectNulls={true} dataKey=\"Official_National_Overall\" name={t.national.nationalOfficialOverallName} stroke=\"#94a3b8\" strokeDasharray=\"3 3\" strokeWidth={2.5} dot={{ r: 4, fill: \"#94a3b8\" }} isAnimationActive={false} />}\n          </ComposedChart>\n        </ResponsiveContainer>\n      </div>\n\n      <div className=\"h-[400px] w-full min-w-0\">\n        <div className=\"flex items-center justify-between mb-4\">\n          <h3 className=\"text-sm font-semibold text-neutral-500 uppercase tracking-wider\">{t.national.inflationRate}</h3>\n          <div className=\"flex bg-white/40 backdrop-blur-md p-1 rounded-xl border border-white/50 shadow-sm\">\n            {([\'DOD\', \'MOM\', \'YOY\'] as const).map(mode => (\n              <button\n                key={mode}\n                onClick={() => setInflationMode(mode)}\n                className={`px-3 py-1.5 text-xs font-semibold rounded-lg transition-all ${inflationMode === mode ? \'bg-white shadow-sm text-sky-600 border border-white/60\' : \'text-neutral-500 hover:text-neutral-700 hover:bg-white/20\'}`}\n              >\n                {mode}\n              </button>\n            ))}\n          </div>\n        </div>\n        <ResponsiveContainer width=\"100%\" height=\"100%\">\n          <ComposedChart syncId=\"nationalSync\" data={inflationData} margin={{ top: 10, right: 10, left: 10, bottom: 0 }}>\n            <CartesianGrid strokeDasharray=\"3 3\" vertical={false} stroke=\"#e5e5e5\" />\n            <XAxis dataKey=\"displayDate\" tick={{fontSize: 12, fill: \'#737373\', fontFamily: \'var(--font-mono)\'}} tickMargin={10} minTickGap={30} />\n            <YAxis tick={{fontSize: 12, fill: \'#737373\', fontFamily: \'var(--font-mono)\'}} tickMargin={10} tickFormatter={(val) => val.toFixed(1) + \'%\'} />\n            <YAxis yAxisId=\"marker\" domain={[0, 100]} hide />\n            <Bar yAxisId=\"marker\" dataKey=\"forwardFillMarker\" name=\"ForwardFillDateToken\" fill=\"#fb923c\" isAnimationActive={false} barSize={4} />\n            <Tooltip content={<CustomTooltip isPercent t={t} />} />\n            <Legend wrapperStyle={{ fontSize: \'13px\', paddingTop: \'20px\' }} />\n            \n            <Line type=\"stepAfter\" dot={false} dataKey=\"Synthetic_National_Inflation\" name={t.national.nationalSyncName} stroke={COLORS[0]} strokeWidth={3} isAnimationActive={false} />\n            {showLaPaz && <Line type=\"stepAfter\" dot={false} dataKey=\"Synthetic_LaPaz_Inflation\" name={t.national.laPazSyncName} stroke={COLORS[1]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            {showCochabamba && <Line type=\"stepAfter\" dot={false} dataKey=\"Synthetic_Cochabamba_Inflation\" name={t.national.cochabambaSyncName} stroke={COLORS[2]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            {showSantaCruz && <Line type=\"stepAfter\" dot={false} dataKey=\"Synthetic_SantaCruz_Inflation\" name={t.national.santaCruzSyncName} stroke={COLORS[3]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            \n            {showOfficial && <Line type=\"linear\" connectNulls={true} dataKey=\"Official_National_Inflation\" name={t.national.nationalOfficialName} stroke={OFFICIAL_COLOR} strokeDasharray=\"5 5\" strokeWidth={2.5} dot={{ r: 4, fill: OFFICIAL_COLOR }} isAnimationActive={false} />}\n            {showOfficialOverall && <Line type=\"linear\" connectNulls={true} dataKey=\"Official_National_Overall_Inflation\" name={t.national.nationalOfficialOverallName} stroke=\"#94a3b8\" strokeDasharray=\"3 3\" strokeWidth={2.5} dot={{ r: 4, fill: \"#94a3b8\" }} isAnimationActive={false} />}\n            <Brush dataKey=\"displayDate\" height={30} stroke=\"#cbd5e1\" tick={{fontSize: 12, fill: \'#737373\', fontFamily: \'var(--font-mono)\'}} />\n          </ComposedChart>\n        </ResponsiveContainer>"
      }
      num_matches: 1
    }
  }
}
