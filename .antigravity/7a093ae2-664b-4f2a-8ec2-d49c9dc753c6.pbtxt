        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let firstOfficialValue: number | null = null;"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    let firstOfficialCategoryValues: Record<string, number> = {};"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "    const catMap: Record<string, string> = {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
