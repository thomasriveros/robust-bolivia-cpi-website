        }
        lines {
          text: "function NationalView({ data }: { data: DataStore }) {"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  const [showLaPaz, setShowLaPaz] = useState(false);"
