        replacement_content: "              <div className=\"absolute left-1/2 -translate-x-1/2 top-full mt-2 w-80 p-4 bg-neutral-900 text-white text-sm rounded-xl shadow-xl opacity-0 invisible group-hover:opacity-100 group-hover:visible transition-all z-50 leading-relaxed font-medium\">\n                This tracker provides a high-frequency, synthetic price index based exclusively on daily supermarket retail data. While the categorization and weighting methodology is benchmarked against the official Instituto Nacional de Estad\303\255stica (INE) framework, this is not a complete Consumer Price Index (CPI). It focuses on a \"Core-5\" basket of retail goods (representing roughly 49% of official weights) and structurally excludes non-retail inflation drivers such as housing, transportation, healthcare services, and utilities. It should be used as a supplementary indicator of retail price trends rather than a replacement for official macroeconomic data.\n              </div>"
      }
