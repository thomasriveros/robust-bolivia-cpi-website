          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "  // Combine synthetic and official data by date"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
