lation\" name=\"Cochabamba (Synthetic)\" stroke={COLORS[2]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            {showSantaCruz && <Line type=\"stepAfter\" dot={false} dataKey=\"Synthetic_SantaCruz_Inflation\" name=\"Santa Cruz (Synthetic)\" stroke={COLORS[3]} strokeWidth={2} opacity={0.8} isAnimationActive={false} />}\n            \n            {showOfficial && <Line type=\"linear\" connectNulls={true} dataKey=\"Official_National_Inflation\" name=\"National (Official INE)\" stroke={OFFICIAL_COLOR} strokeDasharray=\"5 5\" strokeWidth={2.5} dot={{ r: 4, fill: OFFICIAL_COLOR }} isAnimationActive={false} />}\n          </LineChart>\n        </ResponsiveContainer>\n      </div>\n\n      <div className=\"mt-8 flex justify-end\">"
