      replacement_content: "    let firstOfficialValue: number | null = null;\n    let firstOfficialCategoryValues: Record<string, number> = {};\n    const catMap: Record<string, string> = {\n      \'Alimentos y Bebidas No Alcoh\303\263licas\': \'Alimentos y bebidas no alcoh\303\263licas\',\n      \'Bebidas Alcoh\303\263licas y Tabaco\': \'Bebidas alcoh\303\263licas y tabaco\',\n      \'Bienes y Servicios Diversos\': \'Bienes y servicios diversos\',\n      \'Muebles, Bienes y Servicios Dom\303\251sticos\': \'Muebles, bienes y servicios dom\303\251sticos\',\n      \'Prendas de Vestir y Calzado\': \'Prendas de vestir y calzado\'\n    };\n\n    const sortedOfficial = [...(officialData || [])].sort((a, b) => {\n      const dateA = a.Date || a.Index;\n      const dateB = b.Date || b.Index;\n      return new Date(dateA).getTime() - new Date(dateB).getTime();\n    });\n\n    sortedOfficial.forEach(row => {\n      const dateStr = row.Date || row.Index;\n      if (!dateStr) return;\n      const d = new Date(dateStr);\n      const key = d.toISOString().split(\'T\')[0];\n      if (!combined[key]) combined[key] = { dateNum: d.getTime(), displayDate: key };\n      \n      const val = row[\'CPI Equ. Basket\'] || row[\'\303\215NDICE GENERAL\'] || row[\'\303\215NDICE\'] || row[\'Same Basket CPI Santa Cruz\'];\n      if (typeof val === \'number\') {\n        if (firstOfficialValue === null) firstOfficialValue = val;\n        combined[key].Official_CPI = firstOfficialValue ? (val / firstOfficialValue) * 100 : val;\n      }\n\n      for (const cat of categories) {\n        const mappedCat = catMap[cat] || cat;\n        const catVal = row[mappedCat];\n        if (typeof catVal === \'number\') {\n          if (firstOfficialCategoryValues[cat] === undefined) {\n             firstOfficialCategoryValues[cat] = catVal;\n          }\n          const base = firstOfficialCategoryValues[cat];\n          combined[key][`Official_${cat}`] = base ? (catVal / base) * 100 : catVal;\n        }\n      }\n    });"
