        }
        lines {
          text: "            <input type=\"checkbox\" checked={showCochabamba} onChange={e => setShowCochabamba(e.target.checked)} className=\"rounded border-neutral-300 text-emerald-500 focus:ring-emerald-500 w-4 h-4 cursor-pointer\" />"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
