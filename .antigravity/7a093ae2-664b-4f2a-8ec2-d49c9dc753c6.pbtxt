          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Bienes y Servicios Diversos\': \'Bienes y servicios diversos\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
          text: "      \'Muebles, Bienes y Servicios Dom\303\251sticos\': \'Muebles, bienes y servicios dom\303\251sticos\',"
          type: UNIFIED_DIFF_LINE_TYPE_UNCHANGED
        }
        lines {
